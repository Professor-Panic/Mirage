<UI class="app">
    <Viewport id="scene_view" class="editor-texture" minZoom="0.1" maxZoom="10"
      onUpdate="{sceneViewUpdate}"
      onBackgroundDraw="{sceneViewDraw}"/>
    <Container class="hierachy" direction="row" showScrollbars="true">
        <for each="{GameComponents}" as="gc" state="editing=false">
            <!-- Drag source: carries the entity's stable uuid, not the runtime handle. -->
            <StringInput
                mode="trigger"
                if="{!editing}"
                class="class-inspector-names"
                label="{gc.name}"
                value="{gc.name}"
                dragType="entity"
                dragValue="{gc.uuid}"
                onClick="{selected = gc.id}"
                onKey="F2: editing = true; Delete: deleteEntity()"
            />

            <StringInput sync="true"
                if="{editing}"
                class="class-inspector-names"
                value="{gc.name}"
                onSubmit="{editing = false}"
            />
        </for>
        <Button class="hier-create" onClick="{createEntity}">Create Entity</Button>
    </Container>

    <!-- Play / Edit toggle. `mode` is the C++ enum: 0 = Edit, 1 = Play. -->
    <Container class="top-strip toolbar-strip" direction="row">
        <Container class="toolbar" direction="row">
            <Button class="mode-button" sync="true" disabled="{mode == 1}" onClick="{mode = 1}">Play</Button>
            <Button class="mode-button" sync="true" disabled="{mode == 0}" onClick="{mode = 0}">Stop</Button>
            <Label class="mode-status" sync="true">{mode == 1 ? 'Playing' : 'Editing'}</Label>
        </Container>
    </Container>

    <!-- Main menu: sits above the Play / Stop toolbar. -->
    <Container class="top-strip menu-strip" direction="row">
        <Container class="menu-bar" direction="row">
            <Container class="file-menu" direction="column">
                <Button class="file-menu-button" onClick="{toggleFileMenu}">File</Button>
                <Container class="file-dropdown" direction="column" if="{file_menu_open == 1}">
                    <Button class="file-menu-item" onClick="{openSceneDialog}">Open...</Button>
                    <Button class="file-menu-item" onClick="{saveScene}" onKey="Ctrl+S: {saveScene}">Save</Button>
                    <Button class="file-menu-item" onClick="{saveSceneAs}">Save As...</Button>
                </Container>
            </Container>
        </Container>
    </Container>

    <Container class="inspector" direction="column" showScrollbars="true">
        <for each="{Entity_Fields}" as="f">
            <!-- Collapsible header: one per component, and one per field group. -->
            <Button if="{f.isHeader}" class="inspector-header {f.cls}" onClick="{toggleSection()}">{f.title}</Button>
            <!-- Header of one script on the entity: its path and a button that detaches it. -->
            <Row if="{!f.isHeader && f.isScript}" class="inspector-row inspector-script {f.cls}">
                <Label class="inspector-script-name">{f.label}</Label>
                <Button class="inspector-script-remove" onClick="{removeScript()}">x</Button>
            </Row>
            <Row if="{!f.isHeader && !f.isRef && !f.isScript}" class="inspector-row {f.cls}">
                <Label class="inspector-label">{f.label}:</Label>
                <Input class="class-inspector-field" value="{f.value}" sync="true" onSubmit="{refreshUI()}" />
            </Row>
            <Row if="{!f.isHeader && f.isRef && !f.isScript}" class="inspector-row inspector-ref {f.cls}" dropTypes="entity" onDrop="f.value = $event.value.text">
                <Label class="inspector-label">{f.label}:</Label>
                <Label class="inspector-ref-name" sync="true">{f.display}</Label>
                <Button class="inspector-ref-clear" onClick="{f.value = ''}">x</Button>
            </Row>
        </for>
        <!-- Like Unity: always at the end of the inspector, but only with an entity selected. -->
        <Button if="{has_selection == 1}" class="add-component-button" onClick="{openAddMenu}">Add Component</Button>
    </Container>

    <Container class="console">
        <Button class="console-clear" onClick="{clearLog()}">Clear Console</Button>
        <Container class="console-scroll" showScrollbars="true" followTail="true">
            <Label class="console-text" sync="true">{console_text}</Label>
        </Container>
    </Container>

    <!-- Right-click menu for the hierarchy (mirage_editor/editor_menus.h). -->
    <Container class="hier-menu" if="{hier_menu_open == 1}" direction="column">
        <Button class="hier-menu-item" onClick="{createEntity}">Create Entity</Button>
    </Container>

    <!-- Add Component dropdown: search box + one button per component.
         Buttons are filtered live through the `cls` class (sync="true"), no rebuild per keystroke. -->
    <Container class="add-menu" if="{add_menu_open == 1}" direction="column">
        <Input class="add-menu-search" value="{add_filter}" sync="true" />
        <Container class="add-menu-list" direction="column" showScrollbars="true">
            <for each="{AddComponentChoices}" as="c">
                <Button class="add-menu-item {c.cls}" sync="true" onClick="{addComponentChoice()}">{c.name}</Button>
            </for>
        </Container>
    </Container>

    <!-- Modal file picker, backed by mirage_editor/file_dialog.h. -->
    <Container class="file-dialog-overlay" if="{fd_open == 1}" direction="column">
        <Label class="file-dialog-title" sync="true">{fd_title}</Label>
        <Container class="file-dialog-location" direction="row">
            <Button class="file-dialog-small-button" onClick="{fd_action = 3}">Up</Button>
            <Label class="file-dialog-dir" sync="true">{fd_dir}</Label>
        </Container>
        <Container class="file-dialog-list" direction="column" showScrollbars="true">
            <for each="{FileEntries}" as="entry">
                <Button class="file-dialog-entry" onClick="{fd_clicked = entry.index}">{entry.label}</Button>
            </for>
        </Container>
        <Label class="file-dialog-label" if="{fd_save == 1}">File name</Label>
        <Input class="file-dialog-name" if="{fd_save == 1}" value="{fd_name}" sync="true" />
        <Label class="file-dialog-status" sync="true">{fd_status}</Label>
        <Container class="file-dialog-actions" direction="row">
            <Button class="file-dialog-action" onClick="{fd_action = 1}">{fd_save == 1 ? 'Save' : 'Open'}</Button>
            <Button class="file-dialog-action" onClick="{fd_action = 2}">Cancel</Button>
        </Container>
    </Container>
</UI>
