/* ------------------------------------------------------------------ */
/* Hierarchy                                                          */
/* ------------------------------------------------------------------ */

.objects {
    color: white;
}

.hierachy {
    background-color: white;
    position: absolute;
    top: 10%;
    width: 15%;
    border-radius: 10px;
    border-width: 4px;
    font-family: var(--font-main);
    padding: 8px;
    height: 60%;                /* same band as the inspector: ends where the console starts */
    overflow: auto;
}

.class-inspector-names {
    border-color: transparent;
    border-width: 0px;
    show-value-box: false;
    color: black;
}

.class-inspector-names:hover {
    background-color: rgb(192, 181, 181);
    color: black;
}

/* The hierarchy entry currently being dragged */
.class-inspector-names:dragging {
    opacity: 0.5;
}


/* ------------------------------------------------------------------ */
/* Inspector                                                          */
/* ------------------------------------------------------------------ */
:root{
    --font-main:"Inter-Regular"
}
.inspector {
    background-color: white;
    position: absolute;
    top: 10%;
    left: 80%;
    width: 20%;
    height: 60%;                /* explicit height; ends where the console starts (70%) */
    overflow: auto;             /* scroll when the fields are taller than the panel */
    scrollbar-size: 10px;
    scroll-speed: 30;
    font-family: var(--font-main);
    font-size: 14;
    color: black;
    padding: 8px;
    padding-right: 20px;        /* keeps the fields clear of the scrollbar */
    border-radius: 10px;
    gap: 10px;
}

.inspector::scrollbar {
    background-color: rgb(210, 210, 210);     /* track */
}

.inspector::scrollbar-thumb {
    background-color: rgb(120, 120, 130);     /* the draggable part */
}
.inspector-row {
    display: flex;
    flex-direction: row;
    align-items: center;   /* instead of align-self on every field */
    gap: 8px;
}

.inspector-label {
    display: block;        /* inline labels ignore width */
    width: 50px;          /* pick one width wide enough for your longest name */
    flex-shrink: 0;        /* don't let the row squeeze it */
    color: black;
}

.class-inspector-field {
    min-width: 0;              /* lets a flex child shrink below its content width */
    max-width: 100%;
    flex-shrink: 1;
    overflow: hidden;
}
/* Component heading ("Transform", "Game", "Script") */
.inspector-component {
    margin-top: 8px;
    font-size: 18px;
    color: black;
}
/* ------------------------------------------------------------------ */
/* Entity reference fields (drop a hierarchy entry onto the row)      */
/* ------------------------------------------------------------------ */

/* Slightly different tint so ref rows read as "drop here" */
.inspector-ref {
    background-color: rgb(225, 240, 225);
}

/* A hierarchy entry is being held over this row and it accepts it */
.inspector-ref:drag-over {
    background-color: rgb(120, 170, 235);
}

/* Target name ("None" / "Missing" / entity name) fills the space */
.inspector-ref-name {
    flex-grow: 1;
    color: black;
}

.inspector-ref-clear {
    width: 24px;
}

/* ------------------------------------------------------------------ */
/* Play / Edit toolbar                                                */
/* ------------------------------------------------------------------ */

/* Full-width, transparent strips that centre the real bar at any window size. */
.top-strip {
    position: absolute;
    left: 0;
    width: 100%;
    flex-direction: row;
    justify-content: center;
}
.menu-strip    { top: 0%; }
.toolbar-strip { top: 5%; }

.toolbar {
    background-color: white;
    font-family: var(--font-main);
    font-size: 14;
    padding: 6px;
    gap: 8px;
    border-radius: 10px;
    flex-direction: row;
    justify-content: center;
}

.mode-button {
    width: 70px;
}

.mode-status {
    color: black;
}
.console {
    position: absolute;
    top: 70%;
    left: 0%;
    width: 100%;
    height: 30%;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 6px;
    background-color: white;
    color: black;
    overflow: hidden;           /* nothing may draw outside the panel */
}

.console-clear {
    font-family: var(--font-main);
    
}

.console-scroll {
    height: 75%;                /* any non-auto height: now clamped to the parent */
    width: 100%;
    overflow: auto;
    background-color: rgb(245, 245, 245);
    scrollbar-size: 10px;
    scroll-speed: 30;
}
.console-text {
    align-self: flex-start;
    color: black;
    font-family: var(--font-main);
    height: auto; 
}
.console-scroll::scrollbar {
    background-color: rgb(210, 210, 210);     /* track */
}

.console-scroll::scrollbar-thumb {
    background-color: rgb(120, 120, 130);     /* the draggable part */
}

/* ------------------------------------------------------------------ */
/* File menu                                                           */
/* ------------------------------------------------------------------ */
.menu-bar {
    flex-direction: row;
    align-items: flex-start;
    background-color: white;
    padding: 3px;
    gap: 0px;
    border-radius: 6px;
    color: black;
    font-family: var(--font-main);
}

.file-menu {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
}
.file-menu-button {
    width: 90px;
    color: black;
}
.file-dropdown {
    flex-direction: column;
    width: 130px;
    padding: 4px;
    gap: 3px;
    background-color: white;
    border-width: 1px;
    border-color: rgb(150, 150, 150);
}
.file-menu-item {
    width: 100%;
    color: black;
    text-align: left;
}

/* ------------------------------------------------------------------ */
/* RUI file picker dialog                                               */
/* ------------------------------------------------------------------ */
.file-dialog-overlay {
    position: absolute;
    top: 12%;
    left: 25%;
    width: 50%;
    height: 72%;
    padding: 12px;
    gap: 8px;
    flex-direction: column;
    background-color: rgb(248, 248, 248);
    color: black;
    border-width: 2px;
    border-color: rgb(90, 90, 90);
    border-radius: 8px;
}
.file-dialog-title {
    font-size: 20;
    font-family: var(--font-main);
    color: black;
}
.file-dialog-location {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}
.file-dialog-small-button {
    width: 52px;
    font-family: var(--font-main);
}
.file-dialog-dir {
    flex-grow: 1;
    color: black;
    font-family: var(--font-main);
}
.file-dialog-list {
    width: 100%;
    height: 58%;
    flex-direction: column;
    overflow: auto;
    background-color: white;
    border-width: 1px;
    border-color: rgb(190, 190, 190);
    padding: 4px;
    gap: 2px;
}
.file-dialog-entry {
    width: 100%;
    color: black;
    text-align: left;
    font-family: var(--font-main);
}
.file-dialog-label {
    color: black;
    font-family: var(--font-main);
}
.file-dialog-name {
    width: 100%;
    color: black;
    background-color: white;
}
.file-dialog-status {
    color: rgb(100, 45, 25);
}
.file-dialog-actions {
    flex-direction: row;
    justify-content: flex-end;
    gap: 8px;
}
.file-dialog-action {
    width: 90px;
}
.editor-texture {
    position: absolute;
    left: 15%;
    top: 10%;
    width: 65%;
    height: 60%;
    background-color: rgb(20, 20, 24);   /* the viewport paints its own panel */
}

/* ------------------------------------------------------------------ */
/* Scripts in the inspector                                            */
/* ------------------------------------------------------------------ */
.inspector-script {
    align-items: center;
    background-color: rgb(235, 235, 245);
}
.inspector-script-name {
    flex-grow: 1;
    color: black;
}
.inspector-script-remove {
    width: 24px;
}
.add-component-button {
    width: 100%;
    height: 30px;
    margin-top: 10px;
    color: black;
    flex-shrink: 0; 
}

/* ------------------------------------------------------------------ */
/* Right-click menus (mirage_editor/editor_menus.h)                     */
/* ------------------------------------------------------------------ */
/* left/top/width/height are written into .mirage/menu_position.rcss every
   time a menu opens (so it appears at the cursor). The values here are only
   the fallback if that file can't be written. */
.hier-menu {
    position: absolute;
    left: 5%;
    top: 12%;
    width: 170px;
    height: 44px;
    padding: 4px;
    flex-direction: column;
    background-color: white;
    border-width: 1px;
    border-color: rgb(150, 150, 150);
    border-radius: 6px;
    color: black;
    font-family: var(--font-main);
}
.hier-menu-item {
    width: 100%;
    height: 30px;
    color: black;
    text-align: left;
}

.add-menu {
    position: absolute;
    right: 0;                   /* hug the right edge instead of left:80% + 240px overflowing */
    top: 20%;
    width: 240px;
    height: 40%;
    min-height: 240px;
    padding: 6px;
    gap: 6px;
    flex-direction: column;
    background-color: white;
    border-width: 1px;
    border-color: rgb(150, 150, 150);
    border-radius: 6px;
    color: black;
    font-family: var(--font-main);
}
.add-menu-search {
    width: 100%;
    height: 28px;
    color: black;
    background-color: white;
}
.add-menu-list {
    width: 100%;
    height: 80%;                /* explicit (non-auto), so it scrolls instead of growing */
    flex-direction: column;
    overflow: auto;
    gap: 2px;
    scrollbar-size: 10px;
    background-color: rgb(248, 248, 248);
}
.add-menu-list::scrollbar {
    background-color: rgb(210, 210, 210);
}
.add-menu-list::scrollbar-thumb {
    background-color: rgb(120, 120, 130);
}
.add-menu-item {
    width: 100%;
    height: 28px;
    color: black;
    text-align: left;
}
/* Components that are already on the entity, or don't match the search. */
.add-menu-hidden {
    display: none;
}
